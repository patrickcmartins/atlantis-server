# Copie para .env (que está no .gitignore). NUNCA commite o .env.

# Usuário GitHub e fine-grained PAT com acesso SÓ ao infra-live:
#   Contents: RW, Pull requests: RW, Commit statuses: RW, Issues: RW (comentários)
ATLANTIS_GH_USER=patrickcmartins
ATLANTIS_GH_TOKEN=github_pat_xxx
# openssl rand -hex 32  (o mesmo valor vai no webhook do GitHub)
ATLANTIS_GH_WEBHOOK_SECRET=troque-me
ATLANTIS_REPO_ALLOWLIST=github.com/patrickcmartins/infra-live
# URL pública do túnel (ngrok); usada nos links que o Atlantis comenta no PR
ATLANTIS_ATLANTIS_URL=https://SEU-DOMINIO.ngrok-free.app

# openssl rand -hex 16
TFSTATE_DB_PASSWORD=troque-me
# stat -c %g /var/run/docker.sock
DOCKER_GID=999
