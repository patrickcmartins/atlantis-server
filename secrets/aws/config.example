# Copie para secrets/aws/config. Montado em /home/atlantis/.aws (read-only).

# Credencial base: usuário IAM "atlantis-local" que SÓ pode fazer sts:AssumeRole.
[profile atlantis-local]
region = us-east-1

# Role que realmente aplica as mudanças (criada pelo infra-live/aws/bootstrap).
# Credenciais temporárias (1h); a access key sozinha não faz nada.
[profile lab-deployer]
role_arn          = arn:aws:iam::<ACCOUNT_ID>:role/terraform-deployer
source_profile    = atlantis-local
role_session_name = atlantis
region            = us-east-1
